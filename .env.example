# Contentful API credentials
# Required: Your Contentful space ID
CONTENTFUL_SPACE_ID=

# Required: Content Delivery API access token (read-only, published content)
CONTENTFUL_ACCESS_TOKEN=

# Required for setup script: Content Management API token
# Generate at: https://app.contentful.com/account/profile/cma_tokens
CONTENTFUL_MANAGEMENT_TOKEN=

# Optional: Content Preview API access token (draft content)
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# Optional: Secret for preview mode API route
CONTENTFUL_PREVIEW_SECRET=

# Optional: Secret for on-demand revalidation webhook
CONTENTFUL_REVALIDATE_SECRET=

# Optional: Contentful environment (defaults to 'master')
CONTENTFUL_ENVIRONMENT=master

# Optional: Contentful tag for content filtering (multi-space support)
SPACE=

# Optional: Site URL for SEO (sitemap, robots.txt, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: Password protection
PAGE_PASSWORD=
PASSWORD_COOKIE_NAME=
